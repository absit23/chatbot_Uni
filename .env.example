# Copy this file to a new file named .env and put your real keys there.
# .env is listed in .gitignore, so it never goes to GitHub.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional backup, free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# The model that turns text into vectors. If you change it, run src/ingest.py again.
# Smaller, faster option: sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBED_MODEL=BAAI/bge-m3

# true = create a public link for phones, false = this computer only
SHARE=true

# true = phones on the same Wi-Fi can open http://<laptop IP>:7860
LOCAL_NETWORK=true

# Limits that protect your free quota
MAX_QUESTIONS_PER_VISITOR=15
MAX_QUESTIONS_PER_DAY=400
